#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly repo_root

usage() {
    printf 'Usage: %s [--uninstall]\n' "$0"
}

action=install
case "${1:-}" in
    "") ;;
    --uninstall) action=uninstall ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
if (($# > 1)); then
    usage >&2
    exit 2
fi

if [[ -z "${HOME:-}" ]]; then
    printf 'HOME must be set to install BIMAX.\n' >&2
    exit 1
fi

install_hint() {
    case "$1" in
        desktop-file-install | update-desktop-database) printf 'sudo dnf install desktop-file-utils' ;;
        update-mime-database) printf 'sudo dnf install shared-mime-info' ;;
        *) printf 'sudo dnf install %s' "$1" ;;
    esac
}

for command_name in \
    uv \
    desktop-file-install \
    gtk-update-icon-cache \
    update-desktop-database \
    update-mime-database; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'Required command not found: %s\n' "$command_name" >&2
        printf 'On Fedora: %s\n' "$(install_hint "$command_name")" >&2
        exit 1
    fi
done

readonly data_root="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly app_id="app.bimax.simulator"
readonly package_name="bimax-simulation"
readonly desktop_file="$data_root/applications/$app_id.desktop"
readonly icon_file="$data_root/icons/hicolor/scalable/apps/$app_id.svg"
readonly mime_file="$data_root/mime/packages/$app_id.xml"
readonly metainfo_file="$data_root/metainfo/$app_id.metainfo.xml"
bin_dir="$(uv tool dir --bin)"
readonly bin_dir

refresh_caches() {
    update-desktop-database "$data_root/applications"
    update-mime-database "$data_root/mime"
    gtk-update-icon-cache --force --ignore-theme-index \
        "$data_root/icons/hicolor"
}

if [[ "$action" == uninstall ]]; then
    if [[ -d "$(uv tool dir)/$package_name" ]]; then
        uv tool uninstall "$package_name"
    fi
    rm -f "$desktop_file" "$icon_file" "$mime_file" "$metainfo_file"
    mkdir -p "$data_root/applications" "$data_root/mime" "$data_root/icons/hicolor"
    refresh_caches
    printf 'BIMAX is uninstalled.\n'
    exit 0
fi

constraints="$(mktemp)"
trap 'rm -f "$constraints"' EXIT

# uv tool install ignores uv.lock, so pin the tool environment to the locked versions.
uv export --frozen --no-dev --no-emit-project --no-hashes --no-header \
    --directory "$repo_root" --output-file "$constraints" >/dev/null
uv tool install --force --python 3.12 \
    --constraints "$constraints" \
    --reinstall-package "$package_name" \
    "$repo_root"

install -D -m 0644 "$repo_root/src/bimax/icons/bimax.svg" "$icon_file"
install -D -m 0644 "$repo_root/packaging/linux/$app_id.xml" "$mime_file"
install -D -m 0644 "$repo_root/packaging/linux/$app_id.metainfo.xml" "$metainfo_file"

desktop-file-install \
    --dir="$data_root/applications" \
    --set-key=Exec --set-value="$bin_dir/bimax %f" \
    --set-key=TryExec --set-value="$bin_dir/bimax" \
    "$repo_root/packaging/linux/$app_id.desktop"

refresh_caches

printf 'BIMAX is installed at %s/bimax.\n' "$bin_dir"
if [[ "$(command -v bimax || true)" != "$bin_dir/bimax" ]]; then
    printf 'Warning: %s is not first in PATH for the bimax command.\n' "$bin_dir" >&2
    printf 'Add it to your shell profile, then open a new terminal:\n' >&2
    printf "  export PATH=\"%s:\$PATH\"\n" "$bin_dir" >&2
fi
